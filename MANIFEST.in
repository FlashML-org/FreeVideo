include setup.sh test.sh freevideo LICENSE .gitignore .gitattributes .editorconfig
include setup.ps1 test.ps1 freevideo.ps1 setup.cmd test.cmd freevideo.cmd
include __init__.py README.zh-CN.md
include NOTICE THIRD_PARTY_NOTICES.md CONTRIBUTING.md SECURITY.md CITATION.cff
recursive-include example_workflows *.json
recursive-include web *.js *.css
recursive-include web/assets *.svg *.png
recursive-include freevideo_engine/assets *.png *.ico
recursive-include freevideo_engine/launcher *.qml
recursive-include freevideo_engine/launcher/licenses *.txt
recursive-include freevideo_engine/licenses *.txt
recursive-include constraints *.txt
include scripts/bootstrap_linux.sh scripts/build_windows.py scripts/windows_app.py scripts/check_installation.py
include scripts/scan_windows_release.py
include scripts/build_launcher_notices.py
prune docs
include docs/LORA.md docs/LORA.zh-CN.md
prune tests
prune benchmarks
prune distribution
prune .github
exclude AGENTS.md CHANGELOG.md
